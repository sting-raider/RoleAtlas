# Web UI server-to-server connection. Docker Compose overrides this with http://api:8080.
SCOUT_API_URL=http://localhost:8080

# Authentication and internal service trust. Generate unique values with at
# least 32 random bytes before any non-local deployment.
ROLEATLAS_PUBLIC_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
SCOUT_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_EMAIL_FROM=RoleAtlas <no-reply@example.com>

# Maximum wall time for one registered agent tool. The runtime also polls for
# cancellation and applies bounded retry backoff.
AGENT_TOOL_TIMEOUT_MS=20000

# Docker Compose uses its local Mailpit capture service by default. Production
# deployments must provide a real transactional SMTP relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional GitHub OAuth. Both values are required to enable the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rust scout
NATS_URL=nats://127.0.0.1:4222
DATABASE_URL=postgres://firstrung:firstrung@127.0.0.1:5432/firstrung
# Optional override. Leave empty to use the maintained default source catalog.
SCOUT_SEEDS=
# Revisit the maintained source catalog every six hours.
RECRAWL_INTERVAL_SECS=21600
SCOUT_USER_AGENT=RoleAtlasScout/0.1 (+https://your-domain.example/crawler; jobs-only)
CRAWL_DELAY_MS=1500
REQUEST_TIMEOUT_SECS=25
MAX_BODY_BYTES=5242880
# Egress policy: targets resolving to private/loopback/link-local addresses are
# blocked by default. Set true only for local fixture-server testing.
SCOUT_ALLOW_PRIVATE_HOSTS=
# Optional comma-separated host suffix allowlist; when set, no other host is crawled.
SCOUT_EGRESS_ALLOWLIST=
RUST_LOG=firstrung_scout=info
