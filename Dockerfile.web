FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
RUN addgroup --system --gid 1001 roleatlas \
    && adduser --system --uid 1001 --ingroup roleatlas roleatlas
COPY --from=build --chown=roleatlas:roleatlas /app/.next/standalone ./
COPY --from=build --chown=roleatlas:roleatlas /app/.next/static ./.next/static
COPY --from=build --chown=roleatlas:roleatlas /app/public ./public
USER roleatlas
EXPOSE 3000
CMD ["node", "server.js"]
