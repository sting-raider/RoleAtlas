{
  "name": "role-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run build && npm run test:rendered",
    "test:unit": "node scripts/run-ts-tests.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs tests/pages-site.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format:check": "node scripts/check-format.mjs",
    "geography:generate": "node scripts/generate-geography.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "doctor": "node scripts/doctor.mjs",
    "scout:check": "cargo check --manifest-path services/scout/Cargo.toml",
    "scout:test": "cargo test --manifest-path services/scout/Cargo.toml"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "lucide-react": "^1.24.0",
    "next": "^16.3.2",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "unpdf": "^1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@koshmoney/countries": "^1.0.1-beta.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "countries-and-timezones": "^3.9.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "5.9.3",
    "world-countries": "^5.1.0"
  },
  "type": "module"
}
