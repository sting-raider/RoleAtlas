# RoleAtlas production edge. The site address comes from the environment so
# the same file drives any hostname; Caddy obtains and renews certificates
# automatically for https addresses. Only `web` is proxied: the Scout API,
# PostgreSQL, and NATS have no edge route by design (AGENTS.md).
#
# The smoke drill uses deploy/Caddyfile.smoke instead (HTTP-only localhost);
# the compose overlay swaps the bind mount.

{
	# ACME problem reports go here; change to a real operator mailbox.
	email {$ACME_EMAIL:ops@roleatlas.example}
}

{$ROLEATLAS_PUBLIC_URL} {
	encode zstd gzip

	header {
		# Baseline hardening applied to every response.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		# Content-Security-Policy intentionally absent: Next.js ships inline
		# bootstrap scripts and style payloads whose hashes/nonces were not
		# audited for this phase. A guessed policy would break the app or lull
		# operators with unsafe-inline. Observe real responses first, then add
		# nonce-based directives; until then HSTS + frame denial + nosniff carry
		# the baseline. Tracked as follow-up work.
	}

	reverse_proxy web:3000
}
