# RoleAtlas production configuration template.
#
# Copy to deploy/.env.production and fill in every value, then pass it to every
# compose command (compose only auto-reads .env files when invoked from their
# directory):
#
#   cp .env.production.example deploy/.env.production
#
#   docker compose -f deploy/docker-compose.prod.yml \
#     --env-file deploy/.env.production up -d
#
# The leading dot keeps the real file out of git (.gitignore's `.env*` also
# hides this template — `git add -f` if it should be tracked).
#
# Generate every secret with:  openssl rand -base64 32
# Never reuse a value across environments. Rotating BETTER_AUTH_SECRET or
# SCOUT_INTERNAL_SECRET invalidates all sessions / in-flight service tokens —
# do both during a maintenance window with the stack stopped.

# ---------------------------------------------------------------------------
# SECRETS — required, no defaults, hard-fail if unset in compose.
# ---------------------------------------------------------------------------

# Session signing key for Better Auth. Rotate quarterly or after any suspected
# disclosure; rotation signs out every user.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Shared secret between the Next.js web tier and the Scout API. The API rejects
# requests whose Authorization header does not match. Rotate on the same
# schedule as BETTER_AUTH_SECRET.
SCOUT_INTERNAL_SECRET=replace-with-openssl-rand-base64-32

# Password for the PostgreSQL superuser inside the prod stack. Back up before
# rotating: restore drills authenticate with this value.
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# CONFIG — public URLs and origins. Must match the DNS name Caddy serves.
# ---------------------------------------------------------------------------

# Public origin (scheme + host, no trailing slash). Drives Caddy's site block,
# auth cookie scope, and trusted-origin checks.
ROLEATLAS_PUBLIC_URL=https://roleatlas.example

# Comma-separated origins allowed to complete auth flows. Usually just the
# public URL; add staging separately rather than widening production.
AUTH_TRUSTED_ORIGINS=https://roleatlas.example

# Optional mailbox for ACME certificate problem reports.
ACME_EMAIL=ops@roleatlas.example

# ---------------------------------------------------------------------------
# CONFIG — email delivery. Production must point at a real SMTP relay; Mailpit
# exists only under the devtools profile for local smoke runs.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true REQUIRES a reachable SMTP_HOST at boot.
# ---------------------------------------------------------------------------

AUTH_REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.your-relay.example
SMTP_PORT=587
SMTP_FROM=RoleAtlas <no-reply@roleatlas.example>
# Comma-separated emails promoted to admin at signup (and at next sign-in for
# existing accounts). Leave empty on shared deployments; admins can submit new
# careers URLs from the Sources workspace.
ROLEATLAS_ADMIN_EMAILS=ops@roleatlas.example

# ---------------------------------------------------------------------------
# CONFIG — Scout crawl tuning. Defaults mirror docker-compose.yml.
# ---------------------------------------------------------------------------

CRAWL_DELAY_MS=1500
REQUEST_TIMEOUT_SECS=40
MAX_BODY_BYTES=12582912
RECRAWL_INTERVAL_SECS=21600
SCOUT_USER_AGENT=RoleAtlasScout/0.1 (+https://roleatlas.example/crawler; jobs-only)
# Leave empty to use the maintained default source catalog.
SCOUT_SEEDS=
AGENT_TOOL_TIMEOUT_MS=20000
